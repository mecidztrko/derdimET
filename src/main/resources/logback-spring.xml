<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="derdimet"/>

    <appender name="CONSOLE_PLAIN" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%thread] %cyan(%logger{36}) [corr=%X{correlationId:-}] - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>correlationId</includeMdcKeyName>
            <includeMdcKeyName>httpMethod</includeMdcKeyName>
            <includeMdcKeyName>httpPath</includeMdcKeyName>
            <includeMdcKeyName>httpStatus</includeMdcKeyName>
            <includeMdcKeyName>durationMs</includeMdcKeyName>
            <customFields>{"service":"${APP_NAME}"}</customFields>
            <fieldNames>
                <timestamp>@timestamp</timestamp>
                <message>message</message>
                <logger>logger</logger>
                <thread>thread</thread>
                <level>level</level>
                <stackTrace>stack_trace</stackTrace>
            </fieldNames>
        </encoder>
    </appender>

    <!-- Test: okunabilir düz metin -->
    <springProfile name="test">
        <root level="WARN">
            <appender-ref ref="CONSOLE_PLAIN"/>
        </root>
        <logger name="com.derdimet" level="INFO"/>
    </springProfile>

    <!-- Geliştirme: düz metin (correlation ID pattern içinde) -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE_PLAIN"/>
        </root>
        <logger name="com.derdimet" level="DEBUG"/>
        <logger name="org.springframework.security" level="INFO"/>
    </springProfile>

    <!-- Üretim: JSON structured logging -->
    <springProfile name="prod">
        <root level="WARN">
            <appender-ref ref="CONSOLE_JSON"/>
        </root>
        <logger name="com.derdimet" level="INFO"/>
    </springProfile>

    <!-- Profil belirtilmemişse düz metin -->
    <springProfile name="default">
        <root level="INFO">
            <appender-ref ref="CONSOLE_PLAIN"/>
        </root>
    </springProfile>
</configuration>
