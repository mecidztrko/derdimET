# derdimET backend — yerel geliştirme ortam değişkenleri
# Kullanım: cp .env.example .env  →  değerleri düzenleyin  →  ./scripts/run-dev.sh
# Bu dosya repoya eklenmez (.gitignore).

# --- Spring profili ---
SPRING_PROFILES_ACTIVE=dev

# --- MySQL ---
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/derdimET?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# --- Sunucu ---
SERVER_PORT=8081
SERVER_ADDRESS=0.0.0.0

# --- JWT (yerel geliştirme; üretimde güçlü rastgele değer kullanın) ---
DERDIMET_JWT_SECRET=derdimet-local-dev-only-change-in-env-32ch
DERDIMET_JWT_EXPIRATION_MS=604800000

# --- CORS (geliştirme: tüm origin'lere izin) ---
DERDIMET_CORS_ALLOWED_ORIGIN_PATTERNS=*

# --- Demo veri (yalnızca dev profili) ---
DERDIMET_SEED=false

# --- API dokümantasyonu (dev: açık, prod: kapalı) ---
DERDIMET_SWAGGER_ENABLED=true

# --- JPA ---
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# --- Medya yükleme ---
DERDIMET_UPLOAD_DIR=uploads
DERDIMET_UPLOAD_PUBLIC_PREFIX=/uploads
DERDIMET_UPLOAD_MAX_FILE_SIZE=8388608
DERDIMET_MAX_FILE_SIZE=10MB
DERDIMET_MAX_REQUEST_SIZE=60MB
