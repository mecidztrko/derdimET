# İsteğe bağlı: Vite geliştirme sunucusundan başka bir host’taki Spring API’ye bağlanmak için.
# Örnek: aynı Wi‑Fi’deki makinenin LAN IP’si
# VITE_API_BASE_URL=http://192.168.1.10:8080

# İsteğe bağlı: Vite proxy hedefi (varsayılan http://127.0.0.1:8080)
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8080
